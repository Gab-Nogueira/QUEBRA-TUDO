{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "installCommand": "python -m pip install -r requirements_vercel.txt",
  "buildCommand": "python scripts/vercel_build.py",
  "fluid": true,
  "functions": {
    "index.py": {
      "maxDuration": 300,
      "includeFiles": "{.playwright/**,public/**,src/consulta_assistida/**}"
    }
  }
}
